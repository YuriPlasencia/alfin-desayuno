  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action; marker blue, presses 1px.",
      "html": "<button class=\"ds-btn-primary\">Nueva actividad</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:42px;padding:0 16px;border-radius:10px;font-family:var(--font);font-size:14.5px;font-weight:650;border:1px solid transparent;cursor:pointer;background:var(--blue);color:#fff;box-shadow:0 2px 4px -2px rgba(29,63,191,.6);transition:transform .12s ease,background .15s ease}.ds-btn-primary:hover{background:var(--blue-ink)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2.5px solid var(--blue);outline-offset:2px}"
    },
    {
      "name": "Success Button",
      "kind": "button",
      "refersTo": "button-success",
      "description": "Mark-done action; marker green.",
      "html": "<button class=\"ds-btn-success\">Marcar hecha</button>",
      "css": ".ds-btn-success{display:inline-flex;align-items:center;min-height:42px;padding:0 16px;border-radius:10px;border:none;font-family:var(--font);font-size:14.5px;font-weight:650;background:var(--green);color:#fff;box-shadow:0 2px 4px -2px rgba(21,128,61,.6);cursor:pointer;transition:background .15s ease,transform .12s ease}.ds-btn-success:hover{background:var(--green-ink)}.ds-btn-success:active{transform:translateY(1px)}.ds-btn-success:focus-visible{outline:2.5px solid var(--blue);outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary action on white.",
      "html": "<button class=\"ds-btn-outline\">Editar</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;min-height:42px;padding:0 16px;border-radius:10px;font-family:var(--font);font-size:14.5px;font-weight:650;background:var(--board);border:1px solid var(--line-strong);color:var(--ink-2);cursor:pointer;transition:border-color .15s ease,color .15s ease}.ds-btn-outline:hover{border-color:var(--blue);color:var(--blue)}.ds-btn-outline:focus-visible{outline:2.5px solid var(--blue);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Form input with blue focus halo.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Título</span><input class=\"ds-input\" placeholder=\"Ej. Comprar pan\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font-family:var(--font)}.ds-field-label{font-size:13px;font-weight:700;color:var(--ink-2)}.ds-input{min-height:42px;padding:9px 12px;border-radius:10px;border:1px solid var(--line-strong);background:var(--board);font-family:inherit;font-size:15px;color:var(--ink);transition:border-color .15s ease,box-shadow .15s ease}.ds-input::placeholder{color:#8391a7}.ds-input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(29,63,191,.14)}"
    },
    {
      "name": "Magnet",
      "kind": "custom",
      "refersTo": "magnet",
      "description": "A person as a board magnet; the me variant takes the blue wash.",
      "html": "<span class=\"ds-magnet\"><i style=\"background:#E4572E\"></i>Diego</span> <span class=\"ds-magnet is-me\"><i style=\"background:#3B6EA5\"></i>Ana</span>",
      "css": ".ds-magnet{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px 0 5px;border-radius:999px;background:var(--board);border:1px solid var(--line);box-shadow:var(--magnet-shadow);font-family:var(--font);font-size:13px;font-weight:650;color:var(--ink)}.ds-magnet i{width:18px;height:18px;border-radius:50%;box-shadow:0 1px 2px rgba(15,23,42,.35)}.ds-magnet.is-me{border-color:var(--blue-line);background:var(--blue-soft);color:var(--blue-ink)}"
    },
    {
      "name": "Step Check",
      "kind": "custom",
      "refersTo": null,
      "description": "Markable step; checking draws a green marker stroke.",
      "html": "<button class=\"ds-step\" onclick=\"this.classList.toggle('is-done')\"><span class=\"ds-step-box\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5 10 17.5 19.5 6.5\"/></svg></span><span class=\"ds-step-label\">Calcular porciones para 80 personas</span></button>",
      "css": ".ds-step{display:flex;align-items:flex-start;gap:11px;min-height:40px;padding:8px 6px;border:none;background:none;border-radius:8px;text-align:left;font-family:var(--font);cursor:pointer;transition:background .12s ease}.ds-step:hover{background:rgba(29,63,191,.06)}.ds-step:focus-visible{outline:2.5px solid var(--blue);outline-offset:2px}.ds-step-box{display:grid;place-items:center;width:22px;height:22px;border-radius:6px;border:2px solid var(--line-strong);background:var(--board);flex:none;transition:border-color .2s ease,background .2s ease}.ds-step-box svg{width:22px;height:22px;overflow:visible;fill:none;stroke:var(--green);stroke-width:3.2;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:24;stroke-dashoffset:24;transition:stroke-dashoffset .32s var(--ease-out)}.ds-step.is-done .ds-step-box{border-color:var(--green);background:var(--green-soft)}.ds-step.is-done svg{stroke-dashoffset:0}.ds-step-label{font-size:14px;line-height:1.35;color:var(--ink)}.ds-step.is-done .ds-step-label{color:var(--muted);text-decoration:line-through;text-decoration-color:var(--line-strong)}"
    },
    {
      "name": "Countdown",
      "kind": "custom",
      "refersTo": null,
      "description": "Days-left box on the board, marker red.",
      "html": "<div class=\"ds-countdown\"><strong>29</strong><span>días</span></div>",
      "css": ".ds-countdown{display:inline-flex;flex-direction:column;align-items:center;min-width:84px;padding:8px 12px 10px;border-radius:12px;border:2px solid var(--red);color:var(--red);line-height:1;font-family:var(--font)}.ds-countdown strong{font-size:40px;font-weight:850;letter-spacing:-.04em;font-variant-numeric:tabular-nums}.ds-countdown span{margin-top:4px;font-size:12.5px;font-weight:750;text-transform:uppercase;letter-spacing:.06em}"
    },
    {
      "name": "Board Column",
      "kind": "card",
      "refersTo": "kanban-column",
      "description": "Column tray with red uppercase head over a blue rule.",
      "html": "<div class=\"ds-col\"><h3 class=\"ds-col-head\">En curso <span>3</span></h3><div class=\"ds-col-item\">Definir el menú final</div><div class=\"ds-col-item\">Armar el cronograma</div></div>",
      "css": ".ds-col{padding:12px;border-radius:14px;background:var(--frame-2);font-family:var(--font);width:260px}.ds-col-head{display:flex;justify-content:space-between;align-items:center;margin:0 0 10px;padding-bottom:6px;border-bottom:2px solid var(--blue);font-size:12.5px;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--red)}.ds-col-head span{min-width:24px;height:22px;padding:0 7px;border-radius:999px;background:var(--board);color:var(--ink-2);font-size:12px;letter-spacing:0;display:grid;place-items:center;box-shadow:var(--shadow-sm)}.ds-col-item{margin-top:8px;padding:9px 10px;border-radius:8px;background:var(--board);border:1px solid var(--line);font-size:13.5px;font-weight:650;color:var(--ink)}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-rail-item-active",
      "description": "Desktop rail; the active item is a white magnet.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-rail-item is-active\" href=\"#\">Inicio</a><a class=\"ds-rail-item\" href=\"#\">Actividades <b>14</b></a><a class=\"ds-rail-item\" href=\"#\">Equipo</a></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:2px;padding:14px;width:220px;background:var(--rail);font-family:var(--font)}.ds-rail-item{display:flex;align-items:center;padding:10px 12px;border-radius:10px;color:var(--rail-ink);font-size:14.5px;font-weight:600;text-decoration:none;transition:background .15s ease,color .15s ease}.ds-rail-item:hover{background:var(--rail-2);color:#fff}.ds-rail-item:focus-visible{outline:2.5px solid #fff;outline-offset:2px}.ds-rail-item.is-active{background:#fff;color:var(--blue);box-shadow:var(--magnet-shadow)}.ds-rail-item b{margin-left:auto;min-width:22px;height:22px;padding:0 7px;border-radius:999px;background:rgba(255,255,255,.12);color:#fff;font-size:12px;display:grid;place-items:center}"
