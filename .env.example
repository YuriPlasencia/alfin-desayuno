# Ingreso con Google: ID de cliente OAuth (tipo "Aplicación web") de Google Cloud.
# Sin esta variable se entra solo con el nombre (útil en local).
GOOGLE_CLIENT_ID=
# Carpeta de las bases (plataforma y una por evento). En Render: /data
DATA_DIR=/data
# Solo para la primera vez: código con el que se entra al evento Al Fin Desayuno
# migrado. Después cada organizador cambia el código de su evento en Ajustes.
TEAM_CODE=
# Opcional: secreto de las sesiones (si no se define, se genera y guarda en la base).
# SESSION_SECRET=
# Dominio propio de la app (p. ej. https://juntay.pe). Si se define, quien entre por la
# dirección .onrender.com pasa automáticamente al dominio. Déjalo vacío hasta que el
# dominio ya responda (Render muestra "Verified" y el certificado listo).
PUBLIC_URL=

# Lectura de boletas, constancias y cotizaciones con Claude (platform.claude.com → API keys).
# Sin esta clave, o si Claude falla, la app lee con el OCR incluido (Tesseract).
ANTHROPIC_API_KEY=

# Clave del panel /admin (tráfico, consumo de Claude, personas). Sin ella, /admin no existe.
ADMIN_KEY=
