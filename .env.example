# Ingreso con Google: ID de cliente OAuth (tipo "Aplicación web") de Google Cloud.
# Sin esta variable se entra solo con el nombre (útil en local).
GOOGLE_CLIENT_ID=
# Carpeta de las bases (plataforma y una por evento). En Render: /data
DATA_DIR=/data
# Solo para la primera vez: código con el que se entra al evento Al Fin Desayuno
# migrado. Después cada organizador cambia el código de su evento en Ajustes.
TEAM_CODE=
# Opcional: secreto de las sesiones (si no se define, se genera y guarda en la base).
# SESSION_SECRET=
